---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="about" description="about Burak YILDIRIM" />
  </head>
  <body>
    <Header />
    <main>
      <p>Burak YILDIRIM. Grew up in Istanbul, living in Amsterdam since 2018.</p>
      <p>Staff infrastructure engineer. Databases, distributed systems.</p>
      <p>I take photos — analog and digital. Old consoles, books, mechanical pencils. I like things that do less but do it well.</p>
      <p>This site is an archive. For the things I hold onto.</p>
    </main>
    <Footer />
  </body>
</html>
